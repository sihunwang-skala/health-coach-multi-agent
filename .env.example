# copy to .env and fill in; .env is never committed
OPENAI_API_KEY=
COACH_MODEL=gpt-6-luna
COACH_EMBED_MODEL=text-embedding-3-small
# LangSmith tracing (optional). Inputs/outputs are hidden automatically (coach/config.py langsmith_privacy);
# set COACH_TRACE_CONTENT=1 only for synthetic test users.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=exercise-coach
